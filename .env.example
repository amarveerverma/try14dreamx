# ==========================================
# DreamX Environment Variables Template
# Target: India (CM-IN) • INR • Asia/Kolkata
# Note: Never commit real credentials or secrets to Git!
# ==========================================

# Public Platform Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Supabase (Auth, Database, Storage)
# Replace with your actual project keys in Vercel/Supabase dashboards
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only: Never expose SERVICE_ROLE_KEY to client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Buckets (Private By Default)
SUPABASE_STORAGE_BUCKET_RESUMES=resumes
SUPABASE_STORAGE_BUCKET_DELIVERABLES=deliverables
SUPABASE_STORAGE_BUCKET_VERIFICATION=mentor-verification

# Monitoring & Diagnostics (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
